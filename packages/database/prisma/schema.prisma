datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  INACTIVE
}

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
  INACTIVE
}

enum UserRole {
  PLATFORM_ADMIN
  OWNER
  MANAGER
  STAFF
  RECEPTIONIST
}

enum BookingStatus {
  PENDING_PAYMENT
  PAYMENT_SUBMITTED
  PAYMENT_REVIEW
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
  REJECTED
}

enum PaymentMethod {
  CARD_TO_CARD
  ONLINE_GATEWAY
  WALLET
  CASH
  POS
}

enum PaymentStatus {
  PENDING
  PROOF_SUBMITTED
  UNDER_REVIEW
  VERIFIED
  REJECTED
  REFUNDED
}

enum PaymentProofReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum Currency {
  IRR
  IRT
  USD
  EUR
}

model Tenant {
  id            String         @id @default(uuid())
  name          String
  slug          String         @unique
  status        TenantStatus   @default(ACTIVE)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  organizations Organization[]
  memberships   Membership[]

  @@map("tenants")
}

model Organization {
  id              String             @id @default(uuid())
  tenantId        String
  name            String
  slug            String             @unique
  description     String?
  logoUrl         String?
  coverUrl        String?
  phone           String?
  email           String?
  timezone        String             @default("Asia/Tehran")
  currency        Currency           @default(IRT)
  locale          String             @default("fa-IR")
  status          OrganizationStatus @default(ACTIVE)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  tenant          Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  locations       Location[]
  memberships     Membership[]
  cardAccounts    CardAccount[]
  categories      ServiceCategory[]
  services        Service[]
  staffMembers    StaffMember[]
  resources       Resource[]
  blockedPeriods  BlockedPeriod[]
  customers       Customer[]
  bookings        Booking[]
  payments        Payment[]
  auditLogs       AuditLog[]
  schedules       StaffSchedule[]

  @@index([tenantId])
  @@index([slug])
  @@map("organizations")
}

model Location {
  id             String          @id @default(uuid())
  organizationId String
  name           String
  address        String?
  latitude       Float?
  longitude      Float?
  phone          String?
  timezone       String          @default("Asia/Tehran")
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  bookings       Booking[]
  resources      Resource[]
  blockedPeriods BlockedPeriod[]

  @@index([organizationId])
  @@map("locations")
}

model User {
  id            String       @id @default(uuid())
  email         String       @unique
  passwordHash  String
  fullName      String
  phone         String?
  role          UserRole     @default(STAFF)
  isSuperAdmin  Boolean      @default(false)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  memberships   Membership[]
  staffMembers  StaffMember[]
  customers     Customer[]
  auditLogs     AuditLog[]

  @@index([email])
  @@map("users")
}

model Membership {
  id             String       @id @default(uuid())
  userId         String
  tenantId       String
  organizationId String
  role           UserRole     @default(STAFF)
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant         Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([userId])
  @@index([organizationId])
  @@map("memberships")
}

model CardAccount {
  id             String       @id @default(uuid())
  organizationId String
  cardNumber     String
  cardHolderName String
  bankName       String?
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("card_accounts")
}

model ServiceCategory {
  id             String       @id @default(uuid())
  organizationId String
  name           String
  description    String?
  sortOrder      Int          @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  services       Service[]

  @@index([organizationId])
  @@map("service_categories")
}

model Service {
  id                  String           @id @default(uuid())
  organizationId      String
  categoryId          String?
  name                String
  description         String?
  durationMinutes     Int
  price               Int              // Smallest currency unit (e.g. Toman)
  depositAmount       Int              @default(0)
  currency            Currency         @default(IRT)
  bufferBeforeMinutes Int              @default(0)
  bufferAfterMinutes  Int              @default(0)
  isActive            Boolean          @default(true)
  isPublic            Boolean          @default(true)
  deletedAt           DateTime?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  organization        Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category            ServiceCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  staffServices       StaffService[]
  bookings            Booking[]
  bookingItems        BookingItem[]

  @@index([organizationId])
  @@index([categoryId])
  @@map("services")
}

model StaffMember {
  id             String          @id @default(uuid())
  organizationId String
  userId         String?
  displayName    String
  bio            String?
  avatarUrl      String?
  phone          String?
  isBookable     Boolean         @default(true)
  isActive       Boolean         @default(true)
  deletedAt      DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  staffServices  StaffService[]
  bookings       Booking[]
  schedules      StaffSchedule[]
  blockedPeriods BlockedPeriod[]

  @@index([organizationId])
  @@index([userId])
  @@map("staff_members")
}

model StaffService {
  id                    String      @id @default(uuid())
  staffId               String
  serviceId             String
  customPrice           Int?
  customDurationMinutes Int?
  createdAt             DateTime    @default(now())

  staff                 StaffMember @relation(fields: [staffId], references: [id], onDelete: Cascade)
  service               Service     @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([staffId, serviceId])
  @@index([staffId])
  @@index([serviceId])
  @@map("staff_services")
}

model Resource {
  id             String       @id @default(uuid())
  organizationId String
  locationId     String?
  name           String
  type           String       @default("ROOM")
  capacity       Int          @default(1)
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  location       Location?    @relation(fields: [locationId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@map("resources")
}

model StaffSchedule {
  id             String       @id @default(uuid())
  organizationId String
  staffId        String
  dayOfWeek      Int          // 0=Saturday .. 6=Friday
  shiftsJson     String       // JSON array of { startTime: "10:00", endTime: "20:00" }
  breaksJson     String       @default("[]")
  isDayOff       Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  staff          StaffMember  @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@unique([staffId, dayOfWeek])
  @@index([organizationId])
  @@index([staffId])
  @@map("staff_schedules")
}

model BlockedPeriod {
  id             String       @id @default(uuid())
  organizationId String
  staffId        String?
  locationId     String?
  startAt        DateTime
  endAt          DateTime
  reason         String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  staff          StaffMember? @relation(fields: [staffId], references: [id], onDelete: Cascade)
  location       Location?    @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([staffId])
  @@index([startAt, endAt])
  @@map("blocked_periods")
}

model Customer {
  id             String       @id @default(uuid())
  organizationId String
  userId         String?
  fullName       String
  phone          String
  email          String?
  notes          String?
  metadataJson   String?      @default("{}")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  bookings       Booking[]

  @@unique([organizationId, phone])
  @@index([organizationId])
  @@index([phone])
  @@map("customers")
}

model Booking {
  id                  String        @id @default(uuid())
  organizationId      String
  locationId          String?
  customerId          String
  staffId             String?
  serviceId           String?

  code                String        @unique // e.g. BK-8F2K9D
  accessToken         String        @unique

  startAt             DateTime
  endAt               DateTime
  status              BookingStatus @default(PENDING_PAYMENT)

  price               Int
  depositAmount       Int           @default(0)
  currency            Currency      @default(IRT)
  notes               String?
  cancellationReason  String?

  serviceNameSnapshot String
  staffNameSnapshot   String?
  priceSnapshot       Int
  durationSnapshot    Int

  cancelledAt         DateTime?
  completedAt         DateTime?
  deletedAt           DateTime?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  organization        Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  location            Location?     @relation(fields: [locationId], references: [id], onDelete: SetNull)
  customer            Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  staff               StaffMember?  @relation(fields: [staffId], references: [id], onDelete: SetNull)
  service             Service?      @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  items               BookingItem[]
  payments            Payment[]

  @@index([organizationId])
  @@index([staffId, startAt, endAt])
  @@index([customerId])
  @@index([status])
  @@index([startAt])
  @@map("bookings")
}

model BookingItem {
  id                  String   @id @default(uuid())
  bookingId           String
  serviceId           String?
  serviceNameSnapshot String
  priceSnapshot       Int
  durationSnapshot    Int
  createdAt           DateTime @default(now())

  booking             Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  service             Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  @@index([bookingId])
  @@map("booking_items")
}

model Payment {
  id               String         @id @default(uuid())
  organizationId   String
  bookingId        String
  method           PaymentMethod  @default(CARD_TO_CARD)
  amount           Int
  currency         Currency       @default(IRT)
  status           PaymentStatus  @default(PENDING)
  referenceNumber  String?
  paidAt           DateTime?
  verifiedAt       DateTime?
  verifiedByUserId String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  organization     Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  booking          Booking        @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  proofs           PaymentProof[]

  @@index([organizationId])
  @@index([bookingId])
  @@index([status])
  @@map("payments")
}

model PaymentProof {
  id               String                   @id @default(uuid())
  paymentId        String
  fileUrl          String
  mimeType         String
  fileSize         Int
  reviewStatus     PaymentProofReviewStatus @default(PENDING)
  reviewedAt       DateTime?
  reviewedByUserId String?
  rejectionReason  String?
  uploadedAt       DateTime                 @default(now())

  payment          Payment                  @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId])
  @@map("payment_proofs")
}

model AuditLog {
  id             String       @id @default(uuid())
  organizationId String
  actorUserId    String?
  action         String
  entityType     String
  entityId       String
  metadataJson   String?      @default("{}")
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime     @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actorUser      User?        @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([actorUserId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}
