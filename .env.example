# Node / Bun Environment
NODE_ENV=development
PORT=4000
WEB_PORT=3000

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/reservy?schema=public"
# Or SQLite fallback for zero-dependency standalone testing:
# DATABASE_URL="file:./dev.db"

# JWT & Security
JWT_SECRET="super-secret-jwt-key-replace-in-production-min-32-chars"
JWT_EXPIRES_IN="7d"

# CORS
CORS_ORIGIN="http://localhost:3000"

# Public URL
NEXT_PUBLIC_API_URL="http://localhost:4000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Storage
STORAGE_DRIVER="local" # 'local' or 's3'
LOCAL_STORAGE_PATH="./uploads"
# S3_ENDPOINT="http://localhost:9000"
# S3_BUCKET="reservy-uploads"
# S3_ACCESS_KEY="minioadmin"
# S3_SECRET_KEY="minioadmin"
# S3_REGION="us-east-1"

# SMS Provider Adapter
SMS_PROVIDER="mock" # 'mock', 'kavenegar', 'farazsms'
SMS_API_KEY=""
SMS_SENDER_NUMBER=""

# Redis Cache / Queue (Optional)
REDIS_URL="redis://localhost:6379"
