{
  "name": "@reservy/database",
  "version": "1.0.0",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "db:generate": "bun --env-file=../../.env run prisma generate",
    "prisma:generate": "bun --env-file=../../.env run prisma generate",
    "db:push": "bun --env-file=../../.env run prisma db push",
    "db:migrate": "bun --env-file=../../.env run prisma migrate dev",
    "db:migrate:prod": "bun --env-file=../../.env run prisma migrate deploy",
    "db:seed": "bun --env-file=../../.env run ./prisma/seed.ts",
    "db:studio": "bun --env-file=../../.env run prisma studio"
  },
  "dependencies": {
    "@prisma/client": "^5.14.0",
    "@reservy/domain": "workspace:*"
  },
  "devDependencies": {
    "prisma": "^5.14.0"
  }
}