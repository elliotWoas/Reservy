# ==============================================================================
# Node / Bun Environment & Conflict-Free Port Allocation
# ==============================================================================
# Existing services on host:
#   - Main Frontend: 3000
#   - Social (Next.js): 3001
#   - Main Backend: 4000
# Reservy ports (distinct & conflict-free):
PORT=4002
WEB_PORT=3002
NODE_ENV=development

# Optional API Global Prefix (e.g. 'reservy-api' or empty string '' if handled at root or stripped by Nginx)
API_PREFIX=""

# ==============================================================================
# Database (PostgreSQL)
# ==============================================================================
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/reservy?schema=public"

# ==============================================================================
# JWT & Security
# ==============================================================================
JWT_SECRET="super-secret-jwt-key-replace-in-production-min-32-chars"
JWT_EXPIRES_IN="7d"

# ==============================================================================
# CORS Configuration (Comma-separated for multiple origins)
# ==============================================================================
# Local: "http://localhost:3002"
# Production (same domain): "https://wallart.cafe"
CORS_ORIGIN="http://localhost:3002"

# ==============================================================================
# Public URLs & Routing Architecture
# ==============================================================================
# ------------------------------------------------------------------------------
# SCENARIO A: Local Development (standalone ports)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_BASE_PATH=""
NEXT_PUBLIC_APP_URL="http://localhost:3002"
NEXT_PUBLIC_BASE_URL="http://localhost:3002"
NEXT_PUBLIC_API_URL="http://localhost:4002"

# ------------------------------------------------------------------------------
# SCENARIO B: Production under wallart.cafe Subpath (/reservy & /reservy-api)
# Uncomment these when deploying under the shared domain:
# ------------------------------------------------------------------------------
# NEXT_PUBLIC_BASE_PATH="/reservy"
# NEXT_PUBLIC_APP_URL="https://wallart.cafe/reservy"
# NEXT_PUBLIC_BASE_URL="https://wallart.cafe/reservy"
# NEXT_PUBLIC_API_URL="https://wallart.cafe/reservy-api"
# CORS_ORIGIN="https://wallart.cafe"

# ------------------------------------------------------------------------------
# SCENARIO C: Future Standalone Domain (e.g. https://reservy.ir)
# Zero code refactoring required — just update URLs and keep BASE_PATH empty:
# ------------------------------------------------------------------------------
# NEXT_PUBLIC_BASE_PATH=""
# NEXT_PUBLIC_APP_URL="https://reservy.ir"
# NEXT_PUBLIC_BASE_URL="https://reservy.ir"
# NEXT_PUBLIC_API_URL="https://api.reservy.ir"
# CORS_ORIGIN="https://reservy.ir"

# ==============================================================================
# Storage
# ==============================================================================
STORAGE_DRIVER="local" # 'local' or 's3'
LOCAL_STORAGE_PATH="./uploads"
# S3_ENDPOINT="http://localhost:9000"
# S3_BUCKET="reservy-uploads"
# S3_ACCESS_KEY="minioadmin"
# S3_SECRET_KEY="minioadmin"
# S3_REGION="us-east-1"

# ==============================================================================
# SMS Provider Adapter
# ==============================================================================
SMS_PROVIDER="mock" # 'mock', 'kavenegar', 'farazsms'
SMS_API_KEY=""
SMS_SENDER_NUMBER=""

# ==============================================================================
# Redis Cache / Queue (Optional)
# ==============================================================================
REDIS_URL="redis://localhost:6379"

# ==============================================================================
# AI Hairstyle Virtual Try-On Providers
# ==============================================================================
AVALAI_API_KEY="your_avalai_api_key_here"
AVALAI_BASE_URL="https://api.avalai.ir/v1"
IMAGE_EDITING_PROVIDER="avalai" # 'avalai', 'gemini', 'replicate', 'openai', 'fal', 'dev-mock'
